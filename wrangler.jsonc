{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northgo-website",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_SITE_URL": "https://northgo-website.northgo-website.workers.dev",
    "NORTHGO_FRONTEND_ORIGINS": "https://candylibin522.github.io"
  },
  "build": {
    "command": "node build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./northgo-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-inquiries",
      "database_id": "e76e2a73-8a3e-4ac5-b6ca-e824f433b272",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
